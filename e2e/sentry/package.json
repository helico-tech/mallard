{
  "name": "mallard-e2e-sentry",
  "private": true,
  "type": "module",
  "description": "End-to-end tests for mallard with real Sentry SDKs, a real browser and real sourcemap uploads.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsc -p browser-app && node --test --test-concurrency=4 --test-timeout=300000 \"tests/*.test.mjs\"",
    "typecheck": "tsc -p browser-app"
  },
  "devDependencies": {
    "@sentry/browser": "^11.10.0",
    "@sentry/cli": "^3.8.2",
    "@sentry/node": "^11.10.0",
    "@sentry/vite-plugin": "^11.10.0",
    "playwright": "^1.64.1",
    "sentry-cli-v2": "npm:@sentry/cli@^2.58.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
