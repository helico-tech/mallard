    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.16.0",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
