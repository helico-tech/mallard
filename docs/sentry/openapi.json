                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ArtifactBundle"
                  }
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/projects/{project}/stats": {
      "get": {
        "operationId": "project_stats",
        "parameters": [
          {
            "name": "project",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "path",
            "description": "Window, e.g. `24h`, `14d` (default `24h` for stats, `14d` for issues).",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "interval",
            "in": "path",
            "description": "Bucket size for time series, e.g. `1h` (default: window / 24).",
            "required": true,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "from",
            "in": "path",
            "description": "Start of the window (inclusive, RFC 3339).",
