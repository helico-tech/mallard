              "tags",
              "payload"
            ],
            "properties": {
              "culprit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "payload": {
                "type": "object",
                "description": "The full normalized (and symbolicated) Sentry event."
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": false,
                  "prefixItems": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "EventList": {
        "type": "object",
        "required": [
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass as `before` to fetch the next (older) page."
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "required": [
          "event_id",
          "project_id",
          "issue_id",
          "timestamp",
          "received_at",
          "title",
          "level",
          "platform"
