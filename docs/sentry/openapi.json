          "culprit": {
            "type": [
              "string",
              "null"
            ]
          },
          "exception_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_seen": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
