          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "title": {
            "type": "string"
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Trace id (32 hex) from `contexts.trace`, for linking to traces."
          },
          "user": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "IssueActivity": {
        "type": "object",
        "required": [
          "at",
          "status",
          "reason"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "description": "`user`, `regression`, ..."
          },
          "status": {
            "$ref": "#/components/schemas/IssueStatus"
          }
        }
      },
      "IssueDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/IssueSummary"
          },
          {
            "type": "object",
            "required": [
              "tags",
              "activity"
            ],
            "properties": {
              "activity": {
                "type": "array",
