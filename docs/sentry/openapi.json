            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "queue_depth": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "retention_secs": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "How long events are kept, in seconds (0 = forever).",
            "minimum": 0
          },
          "storage": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
