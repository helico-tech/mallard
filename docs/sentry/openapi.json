              "$ref": "#/components/schemas/StatsBucket"
            }
          },
          "interval_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "new_issues": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "project_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "total_events": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "unique_issues": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "window_end": {
            "type": "string",
            "format": "date-time"
          },
          "window_start": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ServerInfo": {
        "type": "object",
        "required": [
