          "last_seen": {
            "type": "string",
            "format": "date-time",
            "description": "Last event in the queried window."
          },
          "level": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "project_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/IssueStatus"
          },
          "title": {
            "type": "string"
          },
          "trend": {
            "type": "array",
