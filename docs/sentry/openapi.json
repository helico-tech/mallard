          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_key": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "ProjectStats": {
        "type": "object",
        "required": [
          "project_id",
          "window_start",
