          "events": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "other": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "warnings": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
