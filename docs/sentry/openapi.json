          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "event_id": {
            "type": "string"
          },
          "issue_id": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "type": "string"
          },
          "project_id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "release": {
            "type": [
              "string",
              "null"
            ]
          },
          "span_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Span id (16 hex) from `contexts.trace`."
