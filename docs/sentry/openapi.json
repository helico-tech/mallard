                "description": "Only in `PATCH` answers: false when the issue already had that status\n(nothing was written)."
              },
              "first_release": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_release": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "latest_event_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TagFacet"
                }
              }
            }
          }
        ]
      },
